 void parameter_unchanged(){require(metadata()==parameter_before_&&catalog()==parameter_catalog_&&hooks_.state()["undo_count"].toInt()==history_,"Parameter export/Cancel mutated document, catalog or history");}
 void export_parameters(const QString &path,bool cancel){
  auto &button=get<QAbstractButton>("exportMaterialLayerParameters");visible(button);
  QTimer::singleShot(0,this,[this,path]{auto *dialog=window_->findChild<QFileDialog *>("materialParameterExportDialog");require(dialog&&dialog->isVisible(),"Real parameter FileDialog did not open");dialog->selectFile(path);QMetaObject::invokeMethod(dialog,"accept",Qt::DirectConnection);});
  button.click();
  if(!hooks_.host.material_parameter_export_pending()){const auto *scope=window_->findChild<QLabel *>("materialLayeringScope"),*error=window_->findChild<QLabel *>("workspaceErrorText");const auto *choice=window_->findChild<QFileDialog *>("materialParameterExportDialog");throw std::runtime_error(("Parameter action did not retain its actual GPU capture; dialog_result="+QString::number(choice?choice->result():-1)+"; selected="+(choice?choice->selectedFiles().join("|"):QString("none"))+"; scope="+(scope?scope->text():QString("missing"))+"; workspace_error="+(error?error->text():QString("none"))).toStdString());}
  if(cancel){auto *dialog=window_->findChild<QProgressDialog *>("materialParameterExportProgress");require(dialog&&dialog->isVisible(),"Parameter progress did not expose Cancel");auto *button=dialog->findChild<QPushButton *>();require(button&&button->isVisible(),"Parameter Cancel button is unavailable");button->click();require(hooks_.host.material_parameter_export_pending(),"Cancel destroyed the pending capture synchronously instead of retiring it");}
 }
 void retain_parameter_masks(){
  make_gpu();int nonuniform_tiles=0;std::array<std::vector<float>,2> first_mask;QFile reference(parameter_reference());require(reference.open(QIODevice::WriteOnly|QIODevice::Truncate),"Parameter reference open");
  hooks_.host.with_gpu([&]{for(int stack=0;stack<3;++stack)for(int tile:{1001,1002}){const auto values=masks_[stack]->sample(tile);require(values.size()==128*128,"Parameter actual mask AOV shape");float minimum=1,maximum=0;for(const auto &pixel:values){require(std::isfinite(pixel[0])&&pixel[0]>=0&&pixel[0]<=1,"Parameter fixture mask is outside the admitted raw-R domain");minimum=std::min(minimum,pixel[0]);maximum=std::max(maximum,pixel[0]);const float scalar=pixel[0];if(roundtrip_producer_&&stack==0)first_mask[tile-1001].push_back(scalar);require(reference.write(reinterpret_cast<const char *>(&scalar),sizeof(scalar))==sizeof(scalar),"Parameter mask reference write");}if(stack==0&&maximum-minimum>.1f)++nonuniform_tiles;}});
  if(roundtrip_producer_){require(first_mask[0].size()==128*128&&first_mask[1].size()==first_mask[0].size(),"Producer asymmetric mask tile shape");for(std::size_t i=0;i<first_mask[0].size();++i)parameter_tile_difference_=std::max(parameter_tile_difference_,std::abs(double(first_mask[0][i])-first_mask[1][i]));require(parameter_tile_difference_>.1,"Roundtrip producer mask0 must differ meaningfully between tiles");}
  require(nonuniform_tiles==2,"Parameter actor must exercise nonuniform GPU masks on both tiles, not only the uniform readback shortcut");reference.close();capture("parameter-mask-paint");
  parameter_before_=metadata();parameter_catalog_=catalog();history_=hooks_.state()["undo_count"].toInt();
 }
 void verify_parameter_package(bool cold){
  std::atomic_bool cancel=false;const auto value=read_material_layer_parameter_package(parameter_path(),cancel);
  if(roundtrip_producer_)require(value.shader.normal_intensity==.5&&value.shader.ao_intensity==.75,"Immutable producer package did not retain actual shader UI .5/.75 values");
  require(value.enabled==set().material_layering.enabled&&value.shader==set().shader_parameters&&value.tiles==std::map<int,std::array<int,2>>({{1001,{128,128}},{1002,{128,128}}}),"Portable parameter values/shader/tile dimensions differ");
  require(G_MAIN&&value.working_space==QString::fromUtf8(G_MAIN->colorspace.scene_linear_name),"Parameter package working-space identity changed");for(int r=0;r<3;++r)for(int c=0;c<3;++c)require(value.scene_linear_to_xyz[r*3+c]==G_MAIN->colorspace.scene_linear_to_xyz[c][r],"Parameter package working matrix changed");
  for(int i=0;i<4;++i)require(layer_material_json(value.materials[i])==layer_material_json(set().material_layering.materials[i]),"Parameter package dropped an applied input/SRT/source");
  QFile reference(parameter_reference());require(reference.open(QIODevice::ReadOnly),"Portable parameter reference missing");const auto bytes=reference.readAll();require(bytes.size()==3*2*128*128*sizeof(float),"Portable parameter reference shape");
  double maximum=0,decoded_tile_difference=0;int components=0;for(int stack=0;stack<3;++stack){const auto &descriptor=*value.masks[stack];const auto original=std::find_if(value.originals.begin(),value.originals.end(),[&](const auto &resource){return resource.asset.toString(QUuid::WithoutBraces).toStdString()==descriptor.asset;});require(original!=value.originals.end(),"Parameter mask original missing");StudioAsset asset;asset.id=original->asset;asset.name=QString::fromStdString(descriptor.name);asset.usages={"texture"};for(const auto &file:original->files)asset.texture_files.push_back(file.descriptor);const auto decoded=decode_fill_texture(asset,true);require(decoded&&decoded->tiles&&decoded->tiles->size()==2,"Portable mask shared decoder omitted tiles");
   if(roundtrip_producer_&&stack==0){const auto &a=*decoded->tiles->at(1001),&b=*decoded->tiles->at(1002);require(a.pixels&&b.pixels&&a.width==128&&a.height==128&&b.width==128&&b.height==128&&a.pixels->size()==128*128&&b.pixels->size()==128*128,"Decoded asymmetric mask tile shape");for(std::size_t i=0;i<128*128;++i){const auto x=a.pixels->at(i)[0],y=b.pixels->at(i)[0];require(std::isfinite(x)&&std::isfinite(y),"Decoded asymmetric mask is nonfinite");decoded_tile_difference=std::max(decoded_tile_difference,std::abs(double(x)-y));}require(decoded_tile_difference>.1,"Decoded package mask0 must differ meaningfully between tiles");}
   for(int tile:{1001,1002}){const auto &member=*decoded->tiles->at(tile);require(member.pixels&&member.width==128&&member.height==128&&member.pixels->size()==128*128,"Portable mask decoded shape");for(std::size_t i=0;i<128*128;++i){float expected=0;std::memcpy(&expected,bytes.constData()+((stack*2+tile-1001)*128*128+i)*sizeof(float),sizeof(float));const auto &pixel=member.pixels->at(i);require(std::isfinite(expected)&&std::all_of(pixel.begin(),pixel.end(),[](float v){return std::isfinite(v);}),"Portable mask nonfinite");maximum=std::max(maximum,std::abs(double(pixel[0])-expected));require(pixel[1]==0&&pixel[2]==0&&pixel[3]==1,"Portable evaluated mask is not canonical R/data-alpha1");components+=4;}}
  }
  const auto count=QDir(parameter_path()+"/payloads").entryList(QDir::Files).size();
  parameter_proof_={{"observed",true},{"cold",cold},{"cancel_retired_without_project_mutation",cold?false:true},{"nonuniform_destination_tiles",2},{"decoded_mask_components",components},{"maximum_mask_error",maximum},{"fixed_tolerance",3e-5},{"unique_payload_files",count},{"original_source_hidden",!QFileInfo(source_).exists()},{"portable_package_path",parameter_path()},{"source_members_version",3},{"scope","Export applied values + evaluated raw mask R; no editable substack history or interactive Import; package reconstruction CPU proof is separate"}};if(roundtrip_producer_){parameter_proof_["distinct_tile_masks"]=true;parameter_proof_["mask0_tile_maximum_difference"]=decoded_tile_difference;parameter_proof_["reference_mask0_tile_maximum_difference"]=parameter_tile_difference_;}write(false);require(maximum<3e-5&&components==393216,"Exported mask pixels differ from actual GPU shader-mask inputs");
 }
 void advance_parameters(){
  switch(stage_){
   case 200:if(roundtrip_producer_){click("shaderSettingsButton");number(get<QDoubleSpinBox>("shaderNormalIntensity"),.5);number(get<QDoubleSpinBox>("shaderAOIntensity"),.75);get<QDialog>("shaderSettings").close();require(set().shader_parameters.normal_intensity==.5&&set().shader_parameters.ao_intensity==.75,"Actual producer shader UI did not apply .5/.75 before Export");}get<QComboBox>("materialOpacitySubstack").setCurrentIndex(1);click("addPaintLayer");stage_=201;break;
   case 201:{const auto name=QString("userChannelValue%1").arg(set().material_layering.mask_slots[0]);auto *field=window_->findChild<QDoubleSpinBox *>(name);require(field,"Parameter paint value missing");number(*field,1);hooks_.stroke({.35,.35},{.65,.65});if(roundtrip_producer_){number(*field,.5);hooks_.stroke({1.2,.25},{1.6,.45});}else hooks_.stroke({1.35,.35},{1.65,.65});stage_=202;break;}
   case 202:retain_parameter_masks();export_parameters(parameter_path()+"-cancelled",true);stage_=203;break;
   case 203:if(hooks_.host.material_parameter_export_pending())return;parameter_unchanged();require(!QFileInfo::exists(parameter_path()+"-cancelled"),"Cancelled parameter package was published");export_parameters(parameter_path(),false);stage_=204;break;
   case 204:if(hooks_.host.material_parameter_export_pending())return;parameter_unchanged();require(QFileInfo(parameter_path()+"/parameters.json").isFile(),"Parameter worker failed to publish a complete package");verify_parameter_package(false);require(bool(hooks_.save),"Parameter actor missing existing Save callback");hooks_.save(project_);stage_=17;break;
