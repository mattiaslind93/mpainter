// WorkspaceSession::run() (app/WorkspaceSession.inc), included in order inside its body; it shares
// that function's locals and is not a standalone file.
if (harness.is_set("gpu-program-warmup-demo")) {
  if (!qEnvironmentVariableIsSet("BTS_GPU_PROGRAM_WARMUP_TEST_OUTPUT"))
    throw std::invalid_argument("Warmup diagnostic requires an output path");
  if (!workspace)
    throw std::invalid_argument("Warmup diagnostic requires --workspace");
  program_warmup_retire = bts::start_gpu_program_warmup_diagnostic(
      viewport,
      qEnvironmentVariable("BTS_GPU_PROGRAM_WARMUP_TEST_OUTPUT"),
      {host,
       [viewport] { return viewport->property("headlessGpuReady").toBool(); },
       [viewport] { return viewport->empty_project; },
       [&] { return !document; },
       [viewport] { return std::uint64_t(viewport->frame_count); },
       [&] {
         QJsonObject state{
             {"has_document", bool(document)},
             {"deferred_executions", workspace->property("newProgramDeferredExecutions").toInt()},
             {"execution_compiler_pending",
              workspace->property("newProgramExecutionCompilerPending").toBool()},
             {"execution_monotonic_ms",
              workspace->property("newProgramExecutionMonotonicMs").toDouble()},
             {"nonempty_guard_waits",
              qint64(viewport->property("gpuProgramNonemptyWaits").toULongLong())},
             {"nonempty_guard_monotonic_ms",
              viewport->property("gpuProgramNonemptyWaitMonotonicMs").toDouble()},
             {"nonempty_guard_frame", viewport->property("gpuProgramNonemptyWaitFrame").toInt()}};
         if (document) {
           state["id"] = document->id().toString(QUuid::WithoutBraces);
           state["mesh"] = QString::fromStdString(document->settings().absolute_mesh_path);
           state["resolution"] = int(document->settings().resolution);
           state["sets"] = int(document->texture_sets().size());
         }
         return state;
       },
       [&] {
         if (!document || document->texture_sets().empty())
           throw std::logic_error("No live New set for pending paint diagnostic");
         const auto set = document->texture_sets().front();
         if (set.disabled || !set.uniform_editable)
           throw std::logic_error("New diagnostic set cannot queue native GPU work");
         host.finish_texture_set(set);  // Existing GPU queue; no document edit or CPU fallback.
       }});
  auto previous = std::move(viewport->before_native_close);
  viewport->before_native_close = [previous = std::move(previous),
                                   retire = program_warmup_retire]() noexcept {
    retire();
    if (previous)
      previous();
  };
}

