+      for (const int eye : {0, 1}) apply_sampling_limit(&image, image.runtime->gputexture[target][eye]);
+    break;
+  }
+  int remaining = 0;
+  for (Image &image : main->images) remaining += mipmap_dirty.contains(image.id.session_uid);
+  return remaining;
+}
