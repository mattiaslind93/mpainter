+  const auto *texture = cached.texture ? *cached.texture : nullptr;
+  if (!texture) return false;
+  if (image->source != IMA_SRC_TILED) {
+    if (tile_number != 1001) return false;
+    region = {0, 0, GPU_texture_width(texture), GPU_texture_height(texture), 0};
+    return true;
+  }
+  ImageTile *tile = BKE_image_get_tile(image, tile_number);
+  if (!tile || tile->runtime.tilearray_size[0] <= 0 || tile->runtime.tilearray_size[1] <= 0) return false;
