+void ImageManager::tag_hosted_updates(bool (*changed)(ImageLoader &, bool))
+{
+  const thread_scoped_lock lock(images_mutex);
+  for (const auto &img : images) {
+    if (img && img->builtin && !img->need_load && changed(*img->loader, false)) {
+      tag_update();
+      return;
+    }
+  }
+}
+
+set<const ImageSingle *> ImageManager::hosted_updates(bool (*changed)(ImageLoader &, bool))
+{
+  /* Snapshot only. Acknowledgment belongs to the existing post-reset reload.
+   * The caller holds Scene::mutex and consumes these identities synchronously. */
+  set<const ImageSingle *> updated;
+  const thread_scoped_lock lock(images_mutex);
+  for (ImageSingle *img : images) {
+    if (img && img->builtin && !img->need_load && changed(*img->loader, false)) {
+      updated.insert(img);
+    }
+  }
+  if (!updated.empty()) {
+    tag_update();
+  }
+  return updated;
+}
+
+size_t ImageManager::reload_hosted_images(Scene *scene, bool (*changed)(ImageLoader &, bool))
+{
+  /* Caller has reset the session; no device kernel may access old pixels. */
+  size_t count = 0;
+  const thread_scoped_lock lock(images_mutex);
+  for (auto [id, img] : images.enumerate()) {
+    if (!img || !img->builtin || img->need_load || !changed(*img->loader, false)) continue;
+    image_cache.free_image(scene->dscene, scene->dscene.image_textures[id]);
+    img->need_load = true;
+    img->need_metadata = true;
+    changed(*img->loader, true);
+    ++count;
+    if (std::getenv("BTS_VERIFY_CYCLES_LIVE")) std::printf("BTS_CYCLES_IMAGE_RELOAD texture_id=%zu\n", size_t(id));
+    tag_update();
+  }
+  return count;
+}
+
 void ImageManager::device_free_builtin(Scene *scene)
 {
   image_udims.clear();
