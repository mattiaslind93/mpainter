diff --git a/source/blender/gpu/GPU_host_metrics.hh b/source/blender/gpu/GPU_host_metrics.hh
new file mode 100644
--- /dev/null
+++ b/source/blender/gpu/GPU_host_metrics.hh
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+namespace blender::gpu::host_metrics {
+// Opt-in counters at the GPU API boundary. Bytes are incoming host data, not VRAM size.
+enum Kind { Upload, Readback, Finish, Mipmap, Count };
+struct Counter { std::atomic<uint64_t> calls{0}, bytes{0}, ns{0}; };
+inline std::array<Counter, Count> counters;
+inline bool enabled() { static const bool yes = std::getenv("BTS_PERFORMANCE_PROFILE") != nullptr; return yes; }
+struct Scope {
+  Kind kind; bool active; std::chrono::steady_clock::time_point start;
+  explicit Scope(Kind k, uint64_t bytes=0):kind(k),active(enabled()) {
+    if(active){start=std::chrono::steady_clock::now();counters[k].calls.fetch_add(1,std::memory_order_relaxed);counters[k].bytes.fetch_add(bytes,std::memory_order_relaxed);}
+  }
+  ~Scope(){if(active)counters[kind].ns.fetch_add(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now()-start).count(),std::memory_order_relaxed);}
+};
+}
diff --git a/source/blender/gpu/GPU_host_texture_memory.hh b/source/blender/gpu/GPU_host_texture_memory.hh
new file mode 100644
--- /dev/null
+++ b/source/blender/gpu/GPU_host_texture_memory.hh
@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <atomic>
+#include <cstdint>
+#include <cstdlib>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+namespace blender::gpu::host_texture_memory {
+// Live logical storage (format/mips/layers), not driver residency. Aliased
+// texture views and buffer views own no additional storage and are not counted.
+struct Group {uint64_t bytes=0,count=0;};
+struct Allocation {uint64_t bytes;std::string label;};
+struct State {
+ std::mutex mutex;
+ std::unordered_map<const void *,std::shared_ptr<Allocation>> allocations;
+ std::map<std::string,Group> labels;
+ std::atomic<uint64_t> bytes{0},count{0};
+};
+// GPU globals can be destroyed after ordinary static destructors. Keep the
+// diagnostics ledger valid for the process lifetime; entries are removed when
+// their owners die. With profiling disabled no ledger is allocated.
+inline State &state(){static auto *value=new State;return *value;}
+inline bool enabled(){static const bool value=std::getenv("BTS_PERFORMANCE_PROFILE")||std::getenv("BTS_RESOLUTION_LOG");return value;}
+inline uint64_t live_bytes(){return enabled()?state().bytes.load():0;}
+inline uint64_t live_count(){return enabled()?state().count.load():0;}
+inline void add(const void *owner,uint64_t bytes,const char *label){
+ if(!enabled())return;auto &s=state();std::lock_guard lock(s.mutex);
+ auto [entry,inserted]=s.allocations.emplace(owner,std::make_shared<Allocation>(Allocation{bytes,label}));
+ if(inserted){auto &group=s.labels[entry->second->label];group.bytes+=bytes;++group.count;s.bytes+=bytes;++s.count;}
+}
+// A view can outlive its original texture object. Retain the shared storage
+// charge until the last owning texture/view object has been destroyed.
+inline void alias(const void *owner,const void *source){
+ if(!enabled())return;auto &s=state();std::lock_guard lock(s.mutex);const auto found=s.allocations.find(source);if(found!=s.allocations.end())s.allocations.emplace(owner,found->second);
+}
+inline void remove(const void *owner){
+ if(!enabled())return;auto &s=state();std::lock_guard lock(s.mutex);const auto entry=s.allocations.find(owner);if(entry==s.allocations.end())return;
+ if(entry->second.use_count()==1){auto &group=s.labels.at(entry->second->label);group.bytes-=entry->second->bytes;--group.count;s.bytes-=entry->second->bytes;--s.count;if(!group.count)s.labels.erase(entry->second->label);}s.allocations.erase(entry);
+}
+inline auto snapshot(){auto &s=state();std::lock_guard lock(s.mutex);return s.labels;}
+}
