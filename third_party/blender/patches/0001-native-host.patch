+void BTS_file_adopt(bContext *C, BlendFileData *bfd)
+{
+  BlendFileReadParams params{};
+  params.skip_flags = BLO_READ_SKIP_USERDEF;
+  BlendFileReadReport reports{};
+  wm_file_read_pre(true, false);
+  BLF_reset_fonts();
+  auto *setup = wm_file_read_setup_wm_init(C, CTX_data_main(C), false);
+  const int runtime_flags = G.f;
+  G.fileflags &= ~G_FILE_NO_UI;
+  BKE_blendfile_read_setup_readfile(C, bfd, &params, setup, &reports, false, nullptr);
+  wm_file_read_setup_wm_finalize(C, CTX_data_main(C), setup);
+  G.f = (G.f & ~G_FLAG_ALL_RUNTIME) | (runtime_flags & G_FLAG_ALL_RUNTIME);
+  G.f &= ~G_FLAG_SCRIPT_AUTOEXEC;
+  BLI_assert(G.background);
+  WM_check(C); // Background mode restores message bus/screens without creating GHOST windows.
+}
