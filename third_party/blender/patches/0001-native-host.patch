+
+  glUseProgram(0);
+  shader = nullptr;
+
+  /* The next bind must restore the frame-buffer, sRGB, viewport and scissor state. */
+  active_fb = nullptr;
+  GLStateManager *gl_state = static_cast<GLStateManager *>(state_manager);
+  gl_state->active_fb = nullptr;
+
+  /* Do not let buffer uploads change a foreign renderer's vertex array. */
+  glBindVertexArray(0);
+  glBindBuffer(GL_ARRAY_BUFFER, 0);
+  glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+  glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+  glActiveTexture(GL_TEXTURE0);
+
+  /* These masks validate draw-call bindings, not the buffers still attached to GL slots. */
+  bound_ubo_slots = 0;
+  bound_ssbo_slots = 0;
+
+  gl_state->restore_external_state();
+}
