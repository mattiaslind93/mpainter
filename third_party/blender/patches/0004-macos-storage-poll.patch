+bool MTLStorageBuf::read_if_ready(void *data)
+{
+  // Owner-context polling only. async_flush_to_host already encoded the managed
+  // memory synchronization before the event. Never enqueue work or wait here.
+  if (data == nullptr || host_read_buffer_ == nil || gpu_write_fence_ == nil ||
+      host_read_signal_value_ == 0 ||
