- MaskEffect gen;
- gen.kind=MaskEffectKind::Generator;
- gen.generator=gen_kind;
- gen.name=gen_name;
- gen.optional_inputs=true;
- gen.map_filter=1;
- gen.contrast=contrast;
- gen.bias=bias;
- gen.ao_influence=ao_inf;
- gen.curvature_influence=curv_inf;
- gen.position_influence=pos_inf;
- gen.normal_influence=norm_inf;
- gen.thickness_influence=.15f;
- gen.triplanar_grunge=true;
- gen.surface_fallback=true;
- if(gen_kind==6){gen.light_direction={0.f,.35f,.93675f};gen.curve=1.f;}
- if(gen_kind==1){gen.axis=2;gen.invert=invert_height;gen.curve=1.f;}
- mask.effects.push_back(gen);
