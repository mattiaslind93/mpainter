-  MaskEffect height;
-  height.kind=MaskEffectKind::Generator;
-  height.generator=1;
-  height.name="Vertical Position Gradient";
-  height.blending=LayerBlend::Multiply;
-  height.opacity=.28f;
-  height.optional_inputs=true;
-  height.axis=2;
-  height.invert=invert_height;
-  height.curve=1.f;
-  height.triplanar_grunge=true;
-  height.surface_fallback=true;
-  mask.effects.push_back(height);
