-  fill.mapping.projection.mode=1;
-  fill.mapping.projection.texture=grunge;
-  fill.mapping.projection.scale3={grunge_scale,grunge_scale,grunge_scale};
-  fill.mapping.projection.hardness=.35;
-  fill.mapping.projection.alpha_mask[0]=false;
-  mask.effects.push_back(fill);
- }
- MaskEffect levels;
- levels.kind=MaskEffectKind::Levels;
- levels.name="Balance & Contrast";
- levels.levels.input_low=levels_low;
- levels.levels.input_high=levels_high;
- levels.levels.gamma=levels_gamma;
- levels.levels.clamp=true;
- mask.effects.push_back(levels);
- return mask;
-}
