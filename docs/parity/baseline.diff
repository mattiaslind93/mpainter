-std::shared_ptr<const FillTexture> load_compact_grunge(const char *resource_path,const char *label){
- QFile source(QString::fromLatin1(resource_path));
- if(!source.open(QIODevice::ReadOnly))throw std::runtime_error(std::string("Missing bundled grunge: ")+resource_path);
- const auto raw_bytes=source.readAll();
- const auto full=QImage::fromData(raw_bytes,"PNG");
- if(full.isNull())throw std::runtime_error(std::string("Invalid bundled grunge PNG: ")+resource_path);
- const auto scaled=full.scaled(128,128,Qt::IgnoreAspectRatio,Qt::SmoothTransformation);
- auto tex=std::make_shared<FillTexture>();
- const QString key=QString("sm_grunge_128_")+QString::fromLatin1(label);
- tex->asset=std_material_id(key).toString(QUuid::WithoutBraces).toStdString();
- QByteArray digest_input=raw_bytes;
- digest_input.append(key.toUtf8());
- tex->hash=QString::fromLatin1(QCryptographicHash::hash(digest_input,QCryptographicHash::Sha256).toHex()).toStdString();
- tex->name=std::string("Grunge ")+label;
- tex->raw=true;
- tex->input_space="Non-Color/raw";
- tex->width=128;
- tex->height=128;
- auto pixels=std::make_shared<std::vector<FillTexture::Pixel>>(128*128);
- for(int y=0;y<128;++y)for(int x=0;x<128;++x){
-  const float v=qRed(scaled.pixel(x,127-y))/255.f;
-  (*pixels)[std::size_t(y)*128+x]={v,v,v,1.f};
- }
- tex->pixels=intern_fill_texture_pixels(*tex,std::move(pixels));
- tex->validate();
- return tex;
-}
